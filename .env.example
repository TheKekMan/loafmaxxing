# ============================================================
# LoafRate — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# BACKEND — Model Settings
# ------------------------------------------------------------

# AI backend mode. One of: mock | cloud | local
#   mock  — Deterministic image-aware mock scoring. Zero latency. No API key needed. (default)
#   cloud — Real VLM analysis via Gemini API (requires GEMINI_API_KEY below)
#   local — Offline Qwen2-VL analysis. Requires running download_model.py first (~4.5 GB).
LOAF_MODEL_TYPE=mock

# Path to locally downloaded Qwen2-VL model (used only when LOAF_MODEL_TYPE=local)
# Default: /app/models/qwen2-vl-2b (inside Docker)
# For native setup, use the absolute path to the model directory on your host.
LOAF_MODEL_PATH=/app/models/qwen2-vl-2b

# HuggingFace model repo ID used by download_model.py
# Change to Qwen/Qwen2-VL-7B-Instruct for a higher quality (but heavier) model.
LOAF_HF_MODEL_ID=Qwen/Qwen2-VL-2B-Instruct

# Gemini API key (used only when LOAF_MODEL_TYPE=cloud)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model ID to use for cloud VLM inference
# Recommended: gemini-2.5-flash (fast + cheap), gemini-2.5-pro (higher quality)
GEMINI_MODEL_ID=gemini-2.5-flash

# Enable GPU (CUDA) acceleration for local model inference
# Set to true if your server has a CUDA-capable GPU and nvidia-container-toolkit installed.
USE_CUDA=false

# Backend server port
BACKEND_PORT=8000


# ------------------------------------------------------------
# FRONTEND — Build & Runtime Settings
# ------------------------------------------------------------

# Public URL of the backend API, as seen from the browser.
# For production: use your domain, e.g. https://api.loafrate.dev
# For local development: http://localhost:8000
# For Docker Compose on the same host: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend server port
FRONTEND_PORT=3000


# ------------------------------------------------------------
# DEPLOYMENT — Production Settings
# ------------------------------------------------------------

# Domain name for your site (used for CORS and SSL setup)
# Example: loafrate.dev
DOMAIN=localhost

# CORS allowed origins for backend (comma-separated)
# In production, restrict to your actual frontend domain.
# Example: https://loafrate.dev,https://www.loafrate.dev
CORS_ORIGINS=*
